# ─── Local / development (copy to .env or .env.local) ───
# Production Cloud Run URLs live in .env.production (used by `next build` / Docker).
# `next dev` does NOT load .env.production — localhost below stays in effect locally.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Browser uses relative /catalog paths (Next rewrites). Server Components use these:
CATALOG_API_BASE=http://localhost:8085
PRICING_API_BASE=http://localhost:8081
PARTY_API_BASE=http://localhost:8082
ORDERS_API_BASE=http://localhost:8083
FACILITY_API_BASE=http://localhost:8084

# next.config.ts rewrites (dev → localhost backends)
CATALOG_PROXY_TARGET=http://localhost:8085
PRICING_PROXY_TARGET=http://localhost:8081
PARTY_PROXY_TARGET=http://localhost:8082
ORDERS_PROXY_TARGET=http://localhost:8083
FACILITY_PROXY_TARGET=http://localhost:8084

# Public product images (no auth required)
NEXT_PUBLIC_CATALOG_IMAGE_BASE=http://localhost:8085

# Store context
NEXT_PUBLIC_PRODUCT_STORE_ID=OFBIZ_STORE
NEXT_PUBLIC_DEFAULT_CATALOG_ID=DEMO_CATALOG
NEXT_PUBLIC_DEFAULT_CURRENCY=INR

# Category / catalog section mapping
NEXT_PUBLIC_BROWSE_ROOT_CATEGORY_ID=CAT-ROOT
NEXT_PUBLIC_BEST_SELLER_CATALOG_TYPE=BEST_SELLER
NEXT_PUBLIC_TRENDING_CATALOG_TYPE=TRENDING_CATALOG
NEXT_PUBLIC_BEST_SELLER_FALLBACK_TYPE=PCCT_MOST_POPULAR
NEXT_PUBLIC_TRENDING_FALLBACK_TYPE=PCCT_WHATS_NEW

# Dev: allow access via LAN IP (comma-separated)
ALLOWED_DEV_ORIGINS=10.30.169.213,localhost

# Testing: allow Add to Cart / Buy Now when product is out of stock (set false for production)
NEXT_PUBLIC_BYPASS_STOCK_CHECK=true

# Server-side auth for BFF → microservices
CATALOG_SERVICE_AUTH_HEADER=admin:ADMIN,FULLADMIN
PARTY_SERVICE_AUTH_HEADER=admin:ADMIN,FULLADMIN
ORDERS_SERVICE_AUTH_HEADER=admin:ADMIN,FULLADMIN
FACILITY_SERVICE_AUTH_HEADER=admin:ADMIN,FULLADMIN

# Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Google Sign-In (OAuth 2.0 Web Client ID from Google Cloud Console)
# Create at https://console.cloud.google.com/apis/credentials using playprosportz@gmail.com
# Authorized JavaScript origins: http://localhost:3000
# Authorized redirect URIs: http://localhost:3000 (optional for GIS button flow)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=1089274910156-ofgjjpbhfesklqf2qns8mrbotkm0jr64.apps.googleusercontent.com
# Same client ID must be set for party service verification:
# GOOGLE_CLIENT_ID=1089274910156-ofgjjpbhfesklqf2qns8mrbotkm0jr64.apps.googleusercontent.com
